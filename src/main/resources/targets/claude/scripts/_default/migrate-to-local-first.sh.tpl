#!/usr/bin/env bash
set -euo pipefail
# migrate-to-local-first.sh — EPIC-0061 Migration Script (RULE-011)
#
# Migrates a .claude/ project generated before EPIC-0061 to the local-first
# lifecycle: copies audit script templates per stack, optionally updates ci.yml.
#
# Usage:
#   bash migrate-to-local-first.sh --dry-run        # Preview changes, no writes
#   bash migrate-to-local-first.sh --apply          # Apply changes idempotently
#   bash migrate-to-local-first.sh --self-check     # Verify dependencies
#
# Exit codes: 0=success, 1=partial failure or nothing to do, 2=operational error
#
# Generated by ia-dev-env for stack: {{BUILD_TOOL}}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$(pwd)}"
SCRIPTS_DIR="${PROJECT_DIR}/.claude/scripts"

DRY_RUN=false
APPLY=false

# ---- Argument parsing ----
case "${1:-}" in
  --dry-run)   DRY_RUN=true ;;
  --apply)     APPLY=true ;;
  --self-check)
    command -v git >/dev/null 2>&1 || { echo "OPERATIONAL_ERROR: git required" >&2; exit 2; }
    echo "Self-check: OK"
    exit 0 ;;
  *)
    echo "Usage: $0 --dry-run | --apply | --self-check" >&2
    exit 2 ;;
esac

# ---- Stack detection heuristic ----
detect_stack() {
  if [[ -f "${PROJECT_DIR}/pom.xml" ]]; then
    if grep -q "spring-boot" "${PROJECT_DIR}/pom.xml" 2>/dev/null; then
      echo "spring-boot"
    else
      echo "java-maven"
    fi
  elif [[ -f "${PROJECT_DIR}/build.gradle" ]] || [[ -f "${PROJECT_DIR}/build.gradle.kts" ]]; then
    echo "java-gradle"
  elif [[ -f "${PROJECT_DIR}/package.json" ]]; then
    echo "node"
  elif [[ -f "${PROJECT_DIR}/pyproject.toml" ]] || [[ -f "${PROJECT_DIR}/requirements.txt" ]]; then
    echo "python"
  elif [[ -f "${PROJECT_DIR}/go.mod" ]]; then
    echo "go"
  else
    echo "_default"
  fi
}

STACK="$(detect_stack)"
echo "Stack detected: ${STACK}"

# ---- Locate audit templates ----
TEMPLATES_DIR="${SCRIPT_DIR}/../${STACK}"
if [[ ! -d "${TEMPLATES_DIR}" ]]; then
  TEMPLATES_DIR="${SCRIPT_DIR}"
fi

TEMPLATES=("${TEMPLATES_DIR}"/*.sh.tpl)
if [[ ${#TEMPLATES[@]} -eq 0 ]] || [[ ! -f "${TEMPLATES[0]}" ]]; then
  echo "WARN: No .sh.tpl templates found in ${TEMPLATES_DIR}" >&2
  exit 1
fi

# ---- Compute changes ----
changes=0
for tpl in "${TEMPLATES[@]}"; do
  tpl_name="$(basename "${tpl}" .tpl)"
  dest="${SCRIPTS_DIR}/${tpl_name}"
  if [[ ! -f "${dest}" ]]; then
    changes=$((changes + 1))
    echo "  ADD: .claude/scripts/${tpl_name}"
  fi
done

if [[ "${changes}" -eq 0 ]]; then
  echo "0 changes (already migrated)"
  exit 0
fi

echo "${changes} change(s) to apply"

if "${DRY_RUN}"; then
  echo "[dry-run] No files written."
  exit 0
fi

# ---- Apply ----
mkdir -p "${SCRIPTS_DIR}"
for tpl in "${TEMPLATES[@]}"; do
  tpl_name="$(basename "${tpl}" .tpl)"
  dest="${SCRIPTS_DIR}/${tpl_name}"
  if [[ ! -f "${dest}" ]]; then
    cp "${tpl}" "${dest}"
    chmod +x "${dest}" 2>/dev/null || true
    echo "  CREATED: .claude/scripts/${tpl_name}"
  fi
done

echo "Migration complete. Run 'bash .claude/scripts/audit-all.sh --self-check' to verify."
exit 0
