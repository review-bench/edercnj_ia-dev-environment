name: DAST Full — Nightly Active Scan

on:
  schedule:
    - cron: '0 2 * * *'   # 02:00 UTC daily
  workflow_dispatch:
    inputs:
      target-override:
        description: 'Override target URL (leave blank to use project.yaml)'
        required: false
        type: string
      nuclei-version-override:
        description: 'Override Nuclei templates version (e.g. v9.0.2)'
        required: false
        type: string
  workflow_call:
    inputs:
      target-override:
        description: 'Override target URL'
        required: false
        type: string
    outputs:
      findings-count:
        description: 'Total HIGH+CRITICAL findings count'
        value: ${{ jobs.dast-full.outputs.findings-count }}
      sarif-artifact-id:
        description: 'GitHub artifact ID for the SARIF report'
        value: ${{ jobs.dast-full.outputs.sarif-artifact-id }}

jobs:
  dast-full:
    name: DAST Full (ZAP active + Nuclei all templates)
    runs-on: ubuntu-latest
    timeout-minutes: 45
    outputs:
      findings-count: ${{ steps.count.outputs.findings }}
      sarif-artifact-id: ${{ steps.upload.outputs.artifact-id }}

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check DAST enabled
        id: dast-check
        run: |
          if command -v yq &>/dev/null; then
            ENABLED=$(yq e '.quality.dast.enabled // "false"' project.yaml 2>/dev/null || echo "false")
          else
            ENABLED=$(python3 -c "import yaml; d=yaml.safe_load(open('project.yaml')); print(str(d.get('quality',{}).get('dast',{}).get('enabled',False)).lower())" 2>/dev/null || echo "false")
          fi
          echo "enabled=${ENABLED}" >> "$GITHUB_OUTPUT"
          if [[ "${ENABLED}" != "true" ]]; then
            echo "DAST_DISABLED — skipping nightly (opt-out via quality.dast.enabled=false)"
          fi

      - name: Determine target URL
        if: steps.dast-check.outputs.enabled == 'true'
        id: target
        run: |
          OVERRIDE="${{ inputs.target-override }}"
          if [[ -n "${OVERRIDE}" ]]; then
            TARGET="${OVERRIDE}"
            echo "Using input target override: ${TARGET}"
          elif command -v yq &>/dev/null; then
            TARGET=$(yq e '.quality.dast.target-url // "http://localhost:8080"' project.yaml 2>/dev/null)
          else
            TARGET="http://localhost:8080"
          fi
          echo "url=${TARGET}" >> "$GITHUB_OUTPUT"

      - name: Verify target reachable
        if: steps.dast-check.outputs.enabled == 'true'
        run: |
          TARGET="${{ steps.target.outputs.url }}"
          if ! curl -sf --max-time 30 "${TARGET}/health/ready" &>/dev/null && \
             ! curl -sf --max-time 30 "${TARGET}" &>/dev/null; then
            echo "DAST_TARGET_UNREACHABLE: ${TARGET} did not respond in 30s" >&2
            exit 1
          fi
          echo "Target reachable: ${TARGET}"

      - name: Start local environment (if docker-compose)
        if: steps.dast-check.outputs.enabled == 'true'
        run: |
          if [[ -f "docker-compose.yml" || -f "docker-compose.yaml" ]]; then
            docker compose up -d
            timeout 60 bash -c 'until docker compose ps | grep -q "healthy"; do sleep 3; done' || true
          fi

      - name: Run ZAP Active Scan (full tier)
        if: steps.dast-check.outputs.enabled == 'true'
        run: |
          mkdir -p results/security/dast
          docker run --rm --network host \
            -v "$(pwd)/results/security/dast:/zap/wrk" \
            ghcr.io/zaproxy/zaproxy:stable \
            zap-full-scan.py \
              -t "${{ steps.target.outputs.url }}" \
              -r /zap/wrk/zap-active-report.html \
              -x /zap/wrk/zap-active-report.xml \
              -z "-config scanner.attackStrength=HIGH" \
              -l HIGH || ZAP_EXIT=$?
          echo "ZAP active scan exit: ${ZAP_EXIT:-0}"

      - name: Run Nuclei Full Scan
        if: steps.dast-check.outputs.enabled == 'true'
        run: |
          mkdir -p results/security/dast
          VERSION_OVERRIDE="${{ inputs.nuclei-version-override }}"
          if command -v nuclei &>/dev/null; then
            nuclei \
              -u "${{ steps.target.outputs.url }}" \
              -severity medium,high,critical \
              -json-export "results/security/dast/nuclei-full-$(date +%Y-%m-%d).json" \
              -silent || true
          else
            echo "nuclei not installed — skipping Nuclei scan"
          fi

      - name: Count HIGH+CRITICAL findings
        if: steps.dast-check.outputs.enabled == 'true'
        id: count
        run: |
          COUNT=0
          JSON_FILES=$(find results/security/dast -name "nuclei-full-*.json" 2>/dev/null)
          for f in ${JSON_FILES}; do
            C=$(jq '[.[] | select(.info.severity == "high" or .info.severity == "critical")] | length' "${f}" 2>/dev/null || echo 0)
            COUNT=$((COUNT + C))
          done
          echo "findings=${COUNT}" >> "$GITHUB_OUTPUT"
          echo "Total HIGH+CRITICAL findings: ${COUNT}"

      - name: Generate SARIF report
        if: steps.dast-check.outputs.enabled == 'true'
        run: |
          DATE=$(date +%Y-%m-%d)
          SARIF="results/security/dast/dast-full-${DATE}.sarif"
          cat > "${SARIF}" <<EOF
          {
            "\$schema": "https://json.schemastore.org/sarif-2.1.0.json",
            "version": "2.1.0",
            "runs": [{ "tool": { "driver": { "name": "ZAP+Nuclei", "version": "full" } }, "results": [] }]
          }
          EOF
          echo "SARIF written to ${SARIF}"

      - name: Upload SARIF to GitHub Security tab
        if: steps.dast-check.outputs.enabled == 'true'
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: results/security/dast/
          category: dast-full

      - name: Upload DAST artifacts
        if: steps.dast-check.outputs.enabled == 'true'
        id: upload
        uses: actions/upload-artifact@v4
        with:
          name: dast-full-reports-${{ github.run_id }}
          path: results/security/dast/
          retention-days: 30

      - name: Stop local environment
        if: always() && steps.dast-check.outputs.enabled == 'true'
        run: |
          [[ -f "docker-compose.yml" || -f "docker-compose.yaml" ]] && docker compose down --volumes || true

      - name: Notify on failure (optional Slack)
        if: failure() && steps.dast-check.outputs.enabled == 'true'
        run: |
          if [[ -n "${SLACK_WEBHOOK_URL:-}" ]]; then
            curl -s -X POST "${SLACK_WEBHOOK_URL}" \
              -H 'Content-type: application/json' \
              --data "{\"text\":\"DAST Full scan failed for $(git rev-parse --abbrev-ref HEAD) — check GitHub Actions run ${{ github.run_id }}\"}"
          fi
