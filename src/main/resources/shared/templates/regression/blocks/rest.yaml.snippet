  - id: "rest-health-check"
    type: rest
    description: "GET /health/ready returns 200"
    command: "curl -s -o /dev/null -w '%{http_code}' http://localhost:8080/health/ready"
    expected:
      exit_code: 0
      stdout_contains: "200"
    timeout_seconds: 10

  - id: "rest-api-root"
    type: rest
    description: "GET /api returns non-5xx"
    command: "curl -s -o /dev/null -w '%{http_code}' http://localhost:8080/api"
    expected:
      exit_code: 0
      stdout_not_contains: "5"
    timeout_seconds: 10
