  - id: "cli-help"
    type: cli
    description: "--help exits 0 and prints usage"
    command: "java -jar target/{{PROJECT_NAME}}.jar --help"
    expected:
      exit_code: 0
      stdout_contains: "Usage"
    timeout_seconds: 10

  - id: "cli-version"
    type: cli
    description: "--version exits 0 and prints version string"
    command: "java -jar target/{{PROJECT_NAME}}.jar --version"
    expected:
      exit_code: 0
      stdout_not_contains: "Exception"
    timeout_seconds: 10

