# macOS
.DS_Store

# FUSE hidden files
.fuse_hidden*

.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# GitHub Copilot — generated output of the boilerplate (except CI workflows and PR template)
.github/*
!.github/workflows/
!.github/pull_request_template.md
!.github/CODEOWNERS
!.github/SETUP-PROTECTION.md
!.github/copilot-instructions.md

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# Temporary files
*.tmp
*.bak

# Java
java/target/
java/dependency-reduced-pom.xml
*.class
*.jar
!java/lib/*.jar

# Maven
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Coverage
java/target/site/
*.exec

# Test output
test-output/
test-output-ts/
output/
# Re-include Java source 'output' directories (hexagonal architecture ports/adapters)
!java/src/**/output/

# .claude/ is versioned in the repo so the team shares the same configuration
# (rules, skills, hooks, agents). Regeneration via ia-dev-env will produce
# diffs that must be reviewed and committed. Local-only artifacts under
# .claude/ remain ignored below.
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/worktrees/

# x-release transient state files (created in Step 0, deleted in Step 12)
/plans/release-state-*.json

# Telemetry NDJSON is a local execution log (generated by
# .claude/hooks/telemetry-*.sh). It is not part of epic deliverables
# and must not be versioned. The wildcard covers epic-NNNN as well as
# the "unknown" fallback bucket emitted when resolve_context cannot
# match the active branch (see telemetry-lib.sh).
plans/*/telemetry/events.ndjson
